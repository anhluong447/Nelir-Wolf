# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# SQLite Databases & Backups (Protects API keys and massive binary databases)
global_settings.db
*.db
*.db-journal
*.sqlite3

# Large / generated project data & save files
dump/
projects/*/project.json
projects/*/dump/
projects/*/dump.tmp/
projects/*/dump_original/
projects/*/dump_original.tmp/
projects/*/game_backup/
projects/*/game_backup.tmp/
projects/*/nelir_dump_*/
*.nel

# Local backups / archives
_backup*/
_archive/

# Scratch & temporary files (tests/ is tracked)
scratch_*.py
inspect_*.py
temp_*/

# OS generated files
.DS_Store
Thumbs.db
